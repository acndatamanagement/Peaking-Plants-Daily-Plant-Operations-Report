	measure YTD_ASPA_Sched_Rate = ```
			
			-- 1. If page filter is "Yes", this is Today-2. If slicer is used, this is the Sliced Date.
			VAR CurrentDate = MAX('ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE])
			
			-- 2. Determine custom fiscal year start (Dec 26th)
			VAR FiscalYearStart = 
			    IF(
			        MONTH(CurrentDate) = 12 && DAY(CurrentDate) >= 26,
			        DATE(YEAR(CurrentDate), 12, 26),
			        DATE(YEAR(CurrentDate) - 1, 12, 26)
			    )
			
			RETURN
			    CALCULATE(
			        -- 3. Final Weighted Calculation (Rate per MWh / 1000)
			        DIVIDE(
			            SUM('PEAKING_PLANTS_PROFILES'[ASPA_REV]),
			            SUM('PEAKING_PLANTS_PROFILES'[ASPA_SCHED]),
			            0
			        ) / 1000,
			        -- 4. CRITICAL: Bypass the page-level "is_today_minus_2" filter
			        REMOVEFILTERS('ASSET_PERFORMANCE_DAILY_REPORT'[is_today_minus_2]),
			        -- 5. Clear the date restriction so the range can expand back to Dec 26
			        REMOVEFILTERS('ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE]),
			        -- 6. Apply the Fiscal Year-to-Date range
			        DATESBETWEEN(
			            'ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE], 
			            FiscalYearStart, 
			            CurrentDate
			        )
			    ) + 0
			```
		formatString: """₱""#,0.00;-""₱""#,0.00;""-"""
		lineageTag: d02d3ff2-4a23-4c94-9b6e-fb2f059bc851

		annotation PBI_FormatHint = {"isCustom":true}

	measure YTD_RM_Sched_Rate_Fiscal = ```
			
			-- 1. Captures the date from your slicer or defaults to Today-2 (via the page filter)
			VAR CurrentDate = MAX('ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE])
			
			-- 2. Logic to find the Dec 26 start point for the YTD cycle
			VAR FiscalYearStart = 
			    IF(
			        MONTH(CurrentDate) = 12 && DAY(CurrentDate) >= 26,
			        DATE(YEAR(CurrentDate), 12, 26),
			        DATE(YEAR(CurrentDate) - 1, 12, 26)
			    )
			
			RETURN
			    CALCULATE(
			        -- 3. Final weighted calculation (Sum of Revenue / Sum of Schedule)
			        DIVIDE(
			            SUM('PEAKING_PLANTS_PROFILES'[RM_REV]),
			            SUM('PEAKING_PLANTS_PROFILES'[RM_SCHED]),
			            0
			        ) / 1000,
			        -- 4. CRITICAL: Bypass the page-level "is_today_minus_2" filter
			        REMOVEFILTERS('ASSET_PERFORMANCE_DAILY_REPORT'[is_today_minus_2]),
			        -- 5. Clear the date restriction so the range can expand back to Dec 26
			        REMOVEFILTERS('ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE]),
			        -- 6. Apply the Fiscal Year-to-Date range
			        DATESBETWEEN(
			            'ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE], 
			            FiscalYearStart, 
			            CurrentDate
			        )
			    ) + 0
			```
		formatString: """₱""#,0.00;-""₱""#,0.00;""-"""
		lineageTag: d18e059e-60fe-4344-8768-585b0e6df7cd

