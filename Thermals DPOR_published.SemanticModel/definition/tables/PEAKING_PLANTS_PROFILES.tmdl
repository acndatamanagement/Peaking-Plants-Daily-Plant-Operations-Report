			        REMOVEFILTERS('ASSET_PERFORMANCE_DAILY_REPORT'[is_today_minus_2]),
			        -- 4. Ignores the date slicer restriction to allow the range to expand
			        REMOVEFILTERS('ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE]),
			        -- 5. Re-applies the specific range we want
			        DATESBETWEEN(
			            'ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE], 
			            FiscalYearStart, 
			            CurrentDate
			        )
			    )
			```
		formatString: #,0
		lineageTag: 1a859e29-0889-40c7-b82e-ed9866354208

		annotation PBI_FormatHint = {"isDecimal":true}

	measure YTD_CF_Avg_Fiscals =
			
			VAR CurrentDate = MAX('ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE])
			VAR FiscalYearStart =
			    IF(
			        MONTH(CurrentDate) > 1 || (MONTH(CurrentDate) = 1 && DAY(CurrentDate) >= 26),
			        DATE(YEAR(CurrentDate), 1, 26),
			        DATE(YEAR(CurrentDate) - 1, 1, 26)
			    )
			VAR FiscalDates =
			    FILTER(
			        ALL('ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE]),
			        'ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE] >= FiscalYearStart &&
			        'ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE] <= CurrentDate
			    )
			RETURN
			AVERAGEX(
			    FiscalDates,
			    CALCULATE(
			        [DAY_CAPACITY_FACTOR],
			        'ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE] = EARLIER('ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE])
			    )
			)
		lineageTag: 5c6db690-5046-4a45-8fe6-2634287e02e9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure MTD_CAPACITY_FACTOR_Fiscal = ```
			
			VAR CurrentDate = MAX(ASSET_PERFORMANCE_DAILY_REPORT[CALENDAR_DATE])
			VAR FiscalStart = 
			    DATE(
			        YEAR(CurrentDate), 
			        MONTH(CurrentDate) - IF(DAY(CurrentDate) < 26, 1, 0), 
			        26
			    )
			
			RETURN
			    CALCULATE(
			        AVERAGEX(
			            VALUES('ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE]),
			            [DAY_CAPACITY_FACTOR]
			        ),
			        -- 1. Remove the page-level "Yes/No" filter
			        REMOVEFILTERS('ASSET_PERFORMANCE_DAILY_REPORT'[is_today_minus_2]),
			        -- 2. Remove any other date-specific filters
			        REMOVEFILTERS('ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE]),
			        -- 3. Apply the actual Fiscal MTD range
			        DATESBETWEEN(
			            'ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE],
			            FiscalStart,
			            CurrentDate
			        )
			    )
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 2038ff73-3507-4115-85cc-93ed125f2e45

	measure YTD_CAPACITY_FACTOR_Fiscal = ```
			
			VAR CurrentDate = MAX(ASSET_PERFORMANCE_DAILY_REPORT[CALENDAR_DATE])
			
			-- 1. Determine custom fiscal year start (Dec 26th)
			VAR FiscalYearStart = 
			    IF(
			        MONTH(CurrentDate) = 12 && DAY(CurrentDate) >= 26,
			        DATE(YEAR(CurrentDate), 12, 26),
			        DATE(YEAR(CurrentDate) - 1, 12, 26)
			    )
			
			RETURN
			    CALCULATE(
			        -- 2. Calculates the average of the daily capacity factor across the year
			        AVERAGEX(
			            VALUES('ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE]),
			            [DAY_CAPACITY_FACTOR]
			        ),
			        -- 3. Bypass the page-level "is_today_minus_2" filter
			        REMOVEFILTERS('ASSET_PERFORMANCE_DAILY_REPORT'[is_today_minus_2]),
			        -- 4. Clear any other date slicers to apply the YTD range
			        REMOVEFILTERS('ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE]),
			        -- 5. Apply the Fiscal Year-to-Date range (Dec 26 to CurrentDate)
			        DATESBETWEEN(
			            'ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE], 
			            FiscalYearStart, 
			            CurrentDate
			        )
			    )
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 26f05a55-3cfe-4ec1-99af-c9552acf1b99

	measure 'Show Current Billing Cycle' = ```
			
			VAR SelectedBilling =
			    CALCULATE(
			        SELECTEDVALUE('PEAKING_PLANTS_PROFILES'[BILLING_DATE]),
			        ALL('PEAKING_PLANTS_PROFILES'[CALENDAR_DATE])
			    )
			VAR AxisDate    = MAX('ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE])
			RETURN
			IF(
			    NOT ISBLANK(SelectedBilling) &&
			    AxisDate >= SelectedBilling &&
			    AxisDate <  EDATE(SelectedBilling, 1),
			    1,
			    0
			)
			
			
			```
		formatString: 0
		lineageTag: 35b14bdb-98b8-4ad3-a75e-f697a9d83bed

	measure 'Show Entire Selected Billing Cycle' =
			
			VAR SelectedBilling =
			    CALCULATE(
			        SELECTEDVALUE('PEAKING_PLANTS_PROFILES'[BILLING_DATE]),
			        ALL('PEAKING_PLANTS_PROFILES'[CALENDAR_DATE])
			    )
			VAR AxisDate    = MAX('PEAKING_PLANTS_PROFILES'[CALENDAR_DATE])
			RETURN
			IF(
			    NOT ISBLANK(SelectedBilling) &&
			    AxisDate >= SelectedBilling &&
			    AxisDate <  EDATE(SelectedBilling, 1),
			    1,
			    0
			)
		formatString: 0
		lineageTag: 1efb439f-c9d2-4098-a167-30fbfb7fd58f

	measure '// Shows only the days from the billing start (26th) up to the *selected* calendar dateShow Days (26..Selected)' =
			
			VAR SelDate = SELECTEDVALUE('PEAKING_PLANTS_PROFILES'[CALENDAR_DATE])
			VAR HasSel  = NOT ISBLANK(SelDate)
			
			VAR StartDate =
			    IF(
			        DAY(SelDate) >= 26,
			        DATE(YEAR(SelDate), MONTH(SelDate), 26),
			        DATE(YEAR(EOMONTH(SelDate, -1)), MONTH(EOMONTH(SelDate, -1)), 26)
			    )
			
			VAR AxisDate = SELECTEDVALUE('PEAKING_PLANTS_PROFILES'[CALENDAR_DATE])
			
			RETURN
			IF(
			    HasSel
			        && NOT ISBLANK(AxisDate)
			        && AxisDate >= StartDate
			        && AxisDate <= SelDate,       // <- Limits to 26..selected day only
			    1, 0
			)
		formatString: 0
		lineageTag: 55dda713-e778-4948-8239-c789fdfb1a5d

	measure MaxFiscalCycleSerial = ```
			
