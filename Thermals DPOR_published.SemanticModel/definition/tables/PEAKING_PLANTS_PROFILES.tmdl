	measure CF_NUMERATOR = ```
			
			VAR ASPA_DAILY = SUM(PEAKING_PLANTS_PROFILES[ASPA_SCHED])
			VAR WESM_DAILY = SUM(PEAKING_PLANTS_PROFILES[WESM_DISPATCH])
			VAR RM_DAILY = SUM(PEAKING_PLANTS_PROFILES[RM_SCHED])
			
