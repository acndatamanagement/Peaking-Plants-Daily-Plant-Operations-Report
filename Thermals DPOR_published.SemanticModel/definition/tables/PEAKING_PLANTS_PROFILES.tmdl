	measure MTD_WESM_Rate_Fiscal =
			
			VAR CurrentDate = MAX('ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE])
			VAR FiscalMonthStart =
			    IF(
			        DAY(CurrentDate) >= 26,
			        DATE(YEAR(CurrentDate), MONTH(CurrentDate), 26),
			        DATE(YEAR(CurrentDate), MONTH(CurrentDate) - 1, 26)
			    )
			VAR FilteredTable =
			    FILTER(
			        ALLSELECTED('PEAKING_PLANTS_PROFILES'),
			        'PEAKING_PLANTS_PROFILES'[CALENDAR_DATE] >= FiscalMonthStart &&
			        'PEAKING_PLANTS_PROFILES'[CALENDAR_DATE] <= CurrentDate
			    )
			VAR TotalWESMRev =
			    SUMX(FilteredTable, 'PEAKING_PLANTS_PROFILES'[WESM_REV])
			VAR TotalWESMDispatch =
			    SUMX(FilteredTable, 'PEAKING_PLANTS_PROFILES'[WESM_DISPATCH])
			VAR Rate =
			    DIVIDE(TotalWESMRev, TotalWESMDispatch) / 1000
			RETURN
			Rate + 0
		formatString: """₱""#,0.00;-""₱""#,0.00;""-"""
		lineageTag: 02f43ebf-6154-462a-831b-e6a7322fbb19

		annotation PBI_FormatHint = {"isCustom":true}

