	measure MTD_PEAKING =
			
			VAR CurrentDate = MAX('ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE])
			VAR FiscalMonthStart =
			    IF(
			        DAY(CurrentDate) >= 26,
			        DATE(YEAR(CurrentDate), MONTH(CurrentDate), 26),
			        DATE(YEAR(CurrentDate), MONTH(CurrentDate) - 1, 26)
			    )
			RETURN
			CALCULATE(
			    SUMX(
			        'PEAKING_PLANTS_PROFILES',
			        'PEAKING_PLANTS_PROFILES'[AVAILABLE_CAPACITY]
			    ),
			    FILTER(
			        ALL('ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE]),
			        'ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE] >= FiscalMonthStart &&
			        'ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE] <= CurrentDate
			    )
			)
		lineageTag: 23a6bb03-b016-49d2-b48b-38914408cacc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure YTD_PEAKING =
			
			TOTALYTD (
			    SUM ( 'PEAKING_PLANTS_PROFILES'[AVAILABLE_CAPACITY]),
			    'ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE]
			)
		lineageTag: 8a6f9bfb-e48b-4261-ae71-dfdae09eb9da

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Daily Value' =
			
			SUM('PEAKING_PLANTS_PROFILES'[ASPA_SCHED]) +
			SUM('PEAKING_PLANTS_PROFILES'[STANDBY_CAPACITY]) +
			SUM('PEAKING_PLANTS_PROFILES'[EXPORT_MWH]) +
			SUM('PEAKING_PLANTS_PROFILES'[RM_SCHED])   -- verify table/column name
		lineageTag: c36433cd-ddb4-4510-b9c6-0278d74b9145

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure MTD_ASPA_W/O_DISPATCH = ```
			
			-- 1. If page filter is "Yes", this is Today-2. If slicer is used, this is the Sliced Date.
			VAR CurrentDate = MAX('ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE])
			
			-- 2. Logic to find the Fiscal Month Start (the 26th)
			VAR FiscalStart =
			    DATE(
			        YEAR(CurrentDate),
			        -- If the day is less than 26, the cycle started in the previous month.
			        MONTH(CurrentDate) - IF(DAY(CurrentDate) < 26, 1, 0),
			        26 
			    )
			
			RETURN
			    CALCULATE(
			        SUM('PEAKING_PLANTS_PROFILES'[ASPA_SCHED_WO_DISPATCH]),
			        -- 3. CRITICAL: Removes the page-level "is_today_minus_2" filter
			        REMOVEFILTERS('ASSET_PERFORMANCE_DAILY_REPORT'[is_today_minus_2]),
			        -- 4. Removes the date restriction so we can see the full range from the 26th
			        REMOVEFILTERS('ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE]),
			        -- 5. Apply the Fiscal Month range
			        DATESBETWEEN(
			            'ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE],
			            FiscalStart,
			            CurrentDate
			        )
			    )
			```
		formatString: #,0.0
		lineageTag: 4fbf340c-695d-46c2-8026-3f51daafce45

