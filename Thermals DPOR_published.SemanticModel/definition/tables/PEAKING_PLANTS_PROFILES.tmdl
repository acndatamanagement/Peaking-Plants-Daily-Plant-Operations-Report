	column PEAKING_DAY_SORT_ORDER =
			
			VAR CurrentDay = DAY('PEAKING_PLANTS_PROFILES'[CALENDAR_DATE])
			RETURN
			    IF(
			        CurrentDay >= 26,
			        CurrentDay - 25,
			        DAY(EOMONTH('PEAKING_PLANTS_PROFILES'[CALENDAR_DATE], -1)) - 25 + CurrentDay
			    )
		formatString: 0
