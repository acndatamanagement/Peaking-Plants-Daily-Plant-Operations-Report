	column FiscalCycleStart =
			
			VAR d = 'PEAKING_PLANTS_PROFILES'[CALENDAR_DATE]
			RETURN
			DATE(
			    YEAR(d) - IF(DAY(d) <= 25 && MONTH(d) = 1, 1, 0),
			    MONTH(d) - IF(DAY(d) <= 25, 1, 0),
			    26
			)
		formatString: General Date
		lineageTag: 5222aec3-f191-4978-b5d1-77cdf0326a87
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column ShowPeakingRange = ```
			
			VAR CurrentDate = TODAY()
			VAR StartDate = DATE(YEAR(CurrentDate), MONTH(CurrentDate), 26)
			VAR EndDate = DATE(YEAR(CurrentDate), MONTH(CurrentDate) + 1, 25)
			RETURN
			IF(
			    'PEAKING_PLANTS_PROFILES'[CALENDAR_DATE] >= StartDate &&
			    'PEAKING_PLANTS_PROFILES'[CALENDAR_DATE] <= EndDate,
			    1,
			    0
			)
			
			```
