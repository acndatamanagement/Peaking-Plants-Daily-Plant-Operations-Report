	partition DAILY_PNL = m
		mode: import
		source =
				let
				    Source = Snowflake.Databases("ayala-acen.snowflakecomputing.com","ACEN_XS_WH",[Implementation="2.0"]),
				    COMOPS_Database = Source{[Name="COMOPS",Kind="Database"]}[Data],
				    PNL_DAILY_Schema = COMOPS_Database{[Name="PNL_DAILY",Kind="Schema"]}[Data],
				    DAILY_PNL_View = PNL_DAILY_Schema{[Name="DAILY_PNL",Kind="View"]}[Data],
				    #"Filtered Rows" = Table.SelectRows(DAILY_PNL_View, each ([LINE_ITEM_SUB_LABEL] = "ASPA TRADING" or [LINE_ITEM_SUB_LABEL] = "RESERVE TRADING" or [LINE_ITEM_SUB_LABEL] = "WESM TRADING") and ([CONTRACT_NAME] = "BPGC-001" or [CONTRACT_NAME] = "CIP2-001" or [CONTRACT_NAME] = "INGRID1-001" or [CONTRACT_NAME] = "INGRID2-001" or [CONTRACT_NAME] = "INGRID3-001" or [CONTRACT_NAME] = "INGRID4-001" or [CONTRACT_NAME] = "INGRID5-001" or [CONTRACT_NAME] = "INGRID6-001" or [CONTRACT_NAME] = "OSPGC-001"))
				in
				    #"Filtered Rows"

