table DAILY_PNL
	lineageTag: 4a66d709-1dc3-408e-a620-375ea5ec47ef

	measure YTD_QUANTITY =
			
			TOTALYTD (
			    SUM ( 'DAILY_PNL'[QUANTITY]),
			    'ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE]
			)
		formatString: #,0
		lineageTag: 5d98bbe3-d30b-467c-9c91-9a3f4e2e8602

		annotation PBI_FormatHint = {"isDecimal":true}

	measure MTD_QUANTITY_RUNNING =
			
			VAR SelectedDate = MAX('ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE])
			VAR FiscalMonthStart =
			    CALCULATE(
			        MIN('ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE]),
			        FILTER(
			            ALL('ASSET_PERFORMANCE_DAILY_REPORT'),
			            'ASSET_PERFORMANCE_DAILY_REPORT'[FISCAL_MONTH] =
			                MAX('ASSET_PERFORMANCE_DAILY_REPORT'[FISCAL_MONTH])
			        )
			    )
			RETURN
			CALCULATE(
			    SUM('DAILY_PNL'[QUANTITY]),
			    DATESBETWEEN(
			        'ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE],
			        FiscalMonthStart,
			        SelectedDate
			    )
			)
		formatString: #,0
		lineageTag: 7701c23d-a484-4ef1-8ce3-8cc6358f5ae2

		annotation PBI_FormatHint = {"isDecimal":true}

	measure MTD_QUANTITY_CHART =
			
			TOTALMTD (
			    SUM ( 'DAILY_PNL'[QUANTITY]),
			    'ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE]
			)
		lineageTag: 5cfc049e-1668-4051-983e-81e5d4baa460

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure CF_Daily =
			
			DIVIDE (
			    SUM ( 'DAILY_PNL'[QUANTITY] ),
			    SELECTEDVALUE ( 'ASSET_PERFORMANCE_DAILY_REPORT'[CAPACITY] ) * 24
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: be707feb-85c3-49ba-b4d8-09f7ca88311e

	measure MTD_CF_Fiscal =
			
			VAR SelectedDate =
			    MAX ( 'ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE] )
			VAR CurrentPlant =
			    SELECTEDVALUE ( 'ASSET_PERFORMANCE_DAILY_REPORT'[PLANT_NAME] )
			VAR FiscalMonth =
			    CALCULATE (
			        MAX ( 'ASSET_PERFORMANCE_DAILY_REPORT'[FISCAL_MONTH] ),
			        'ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE] = SelectedDate
			    )
			VAR FiscalMonthDates =
			    FILTER (
			        ALL ( 'ASSET_PERFORMANCE_DAILY_REPORT' ),
			        'ASSET_PERFORMANCE_DAILY_REPORT'[FISCAL_MONTH] = FiscalMonth &&
			        'ASSET_PERFORMANCE_DAILY_REPORT'[PLANT_NAME] = CurrentPlant &&
			        'ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE] <= SelectedDate
			    )
			RETURN
			AVERAGEX (
			    FiscalMonthDates,
			    VAR DailyGen =
			        CALCULATE (
			            SUM ( 'DAILY_PNL'[QUANTITY] ),
			            'ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE]
			        )
			    VAR Capacity =
			        CALCULATE (
			            MAX ( 'ASSET_PERFORMANCE_DAILY_REPORT'[CAPACITY] ),
			            'ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE]
			        )
			    RETURN DIVIDE ( DailyGen, Capacity * 24 )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4ca9f3b6-c08b-42a7-bff4-60faeff4a852

	measure MTD_CF_100 = 1-[MTD_CF_Fiscal]
		lineageTag: bad89cf1-b276-4b0a-ab87-2cc4752b8e50

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure YTD_CF_Avg_Fiscal =
			
			VAR CurrentDate = MAX('ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE])
			VAR FiscalYearStart =
			    IF(
			        MONTH(CurrentDate) > 1 || (MONTH(CurrentDate) = 1 && DAY(CurrentDate) >= 26),
			        DATE(YEAR(CurrentDate), 1, 26),
			        DATE(YEAR(CurrentDate) - 1, 1, 26)
			    )
			VAR FiscalDates =
			    FILTER(
			        ALL('ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE]),
			        'ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE] >= FiscalYearStart &&
			        'ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE] <= CurrentDate
			    )
			RETURN
			AVERAGEX(
			    FiscalDates,
			    CALCULATE([CF_Daily])
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 2e6d826a-5de0-4230-b436-2f5c46110a22

	measure YTD_GEN =
			
			TOTALYTD(
			    SUM('DAILY_PNL'[QUANTITY]),
			    'ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE]
			)
		formatString: #,0
