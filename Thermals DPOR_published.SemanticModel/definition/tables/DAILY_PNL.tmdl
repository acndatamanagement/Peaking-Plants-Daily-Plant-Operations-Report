	measure YTD_GEN_LABEL =
			
			FORMAT(
			    [YTD_GEN],
			    "0,00"
			) & " MWh"
		lineageTag: 0fc03bb7-cb57-4dec-a240-58612c22ea74

	measure MTD_GEN_LABEL =
			
			FORMAT(
			    [MTD_QUANTITY_RUNNING],
			    "0"
			) & " MWh"
		lineageTag: 6101553f-2705-474b-8c64-e4bfb53b3aa5

	measure DAY_GEN =
			
			FORMAT(
			    SUM('DAILY_PNL'[QUANTITY]),
			    "00"
			) & " MWh"
		lineageTag: ef4bc413-32d9-43fe-9219-d04bafcb937e

	measure RM_RATE =
			
			DIVIDE(
			    SUMX('DAILY_PNL', 'DAILY_PNL'[QUANTITY] * 'DAILY_PNL'[RATE]),
			    SUM('DAILY_PNL'[QUANTITY])
			)/ 1000
		formatString: "₱"#,0.00;-"₱"#,0.00;"₱"#,0.00
		lineageTag: 468d0f60-c703-412d-8392-b043fa884247

		annotation PBI_FormatHint = {"currencyCulture":"ceb-Latn-PH"}

	measure RM_RATE_MTD =
			
			VAR CurrentDate = MAX('DAILY_PNL'[CALENDAR_DATE])
			VAR FiscalMonthStart =
			    IF(
			        DAY(CurrentDate) >= 26,
			        DATE(YEAR(CurrentDate), MONTH(CurrentDate), 26),
			        DATE(YEAR(CurrentDate), MONTH(CurrentDate) - 1, 26)
			    )
			VAR FilteredTable =
			    FILTER(
			        ALLSELECTED('DAILY_PNL'),
			        'DAILY_PNL'[CALENDAR_DATE] >= FiscalMonthStart &&
			        'DAILY_PNL'[CALENDAR_DATE] <= CurrentDate
			    )
			VAR WeightedSum =
			    SUMX(FilteredTable, 'DAILY_PNL'[QUANTITY] * 'DAILY_PNL'[RATE])
			VAR TotalQuantity =
			    SUMX(FilteredTable, 'DAILY_PNL'[QUANTITY])
			RETURN
			DIVIDE(WeightedSum, TotalQuantity) / 1000
		formatString: "₱"#,0.00;-"₱"#,0.00;"₱"#,0.00
		lineageTag: 6ee08146-97da-4671-9fe8-5577a9b8d6de

		annotation PBI_FormatHint = {"currencyCulture":"ceb-Latn-PH"}

	measure RM_RATE_YTD =
			
			DIVIDE(
			    CALCULATE(
			        SUMX(
			            'DAILY_PNL',
			            'DAILY_PNL'[QUANTITY] * 'DAILY_PNL'[RATE]
			        ),
			        DATESYTD(ASSET_PERFORMANCE_DAILY_REPORT[CALENDAR_DATE])  -- Replace with your actual date column
			    ),
			    CALCULATE(
			        SUM('DAILY_PNL'[QUANTITY]),
			        DATESYTD('ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE])  -- Same date column
			    )
			) / 1000
		formatString: "₱"#,0.00;-"₱"#,0.00;"₱"#,0.00
		lineageTag: 1749c042-ea5f-4b39-8e63-b38c3748525e

		annotation PBI_FormatHint = {"currencyCulture":"ceb-Latn-PH"}

