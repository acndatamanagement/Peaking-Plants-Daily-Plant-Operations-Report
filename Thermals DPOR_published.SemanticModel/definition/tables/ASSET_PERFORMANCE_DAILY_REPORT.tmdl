table ASSET_PERFORMANCE_DAILY_REPORT
	lineageTag: 59d71a29-0e97-45a6-9470-15eadee3a4b9

	measure YTD_GENERATION_Fiscal = ```
			
			-- 1. If page filter is "Yes", this is Today-2. If slicer is used, this is the Sliced Date.
			VAR CurrentDate = MAX('ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE])
			
			-- 2. Determine custom fiscal year start (Dec 26th)
			VAR FiscalYearStart = 
			    IF(
			        MONTH(CurrentDate) = 12 && DAY(CurrentDate) >= 26,
			        DATE(YEAR(CurrentDate), 12, 26),
			        DATE(YEAR(CurrentDate) - 1, 12, 26)
			    )
			
			RETURN
			    CALCULATE(
			        SUM('ASSET_PERFORMANCE_DAILY_REPORT'[DAILY_GENERATION]),
			        -- 3. CRITICAL: Bypass the page-level "is_today_minus_2" filter
			        REMOVEFILTERS('ASSET_PERFORMANCE_DAILY_REPORT'[is_today_minus_2]),
			        -- 4. Clear the date restriction so the range can expand back to Dec 26
			        REMOVEFILTERS('ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE]),
			        -- 5. Apply the Fiscal Year-to-Date range
			        DATESBETWEEN(
			            'ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE], 
			            FiscalYearStart, 
			            CurrentDate
			        )
			    )
			```
		formatString: #,0.00
		lineageTag: 50e29c31-abce-42d5-8708-6439fb91cdf1

	measure YTD_CF =
			
			TOTALYTD (
			    AVERAGE( ASSET_PERFORMANCE_DAILY_REPORT[DAILY_CAPACITY_FACTOR]),
			    'ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 28b566a4-82de-4f2b-99d2-587fbdde4d14

	measure MWH_ytd_GEN_LABEL =
			
			FORMAT('ASSET_PERFORMANCE_DAILY_REPORT'[YTD_GENERATION_Fiscal], "#,##0") & " MWh"
		lineageTag: 233c31d5-1266-4f05-9476-7dd648f536f6

	measure CF_MEASURE = MAX(ASSET_PERFORMANCE_DAILY_REPORT[MONTHLY_CAPACITY_FACTOR])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 660b1b13-6e39-4fc6-a7f3-435c7347dfa2

	measure MTD_CF_PLACEHOLDER = 1-[CF_MEASURE]
		lineageTag: 4dfd28a5-f3ce-4424-965f-fdc97cc09545

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure YTD_AVAILABILITY_Fiscal = ```
			
			VAR CurrentDate = MAX('ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE])
			
			-- 1. Correct Fiscal Start to reset on December 26th
			VAR FiscalYearStart = 
			    IF(
			        MONTH(CurrentDate) = 12 && DAY(CurrentDate) >= 26,
			        DATE(YEAR(CurrentDate), 12, 26),
			        DATE(YEAR(CurrentDate) - 1, 12, 26)
			    )
			
			-- 2. Calculate the Average ignoring Date slicer but respecting other filters
			VAR YTD_Avail = 
			    CALCULATE(
			        AVERAGEX(ASSET_PERFORMANCE_DAILY_REPORT,
			        'ASSET_PERFORMANCE_DAILY_REPORT'[DAILY_AVAILABILITY]),
			        -- Target the Date column of the table being used in your report slicer
			        REMOVEFILTERS('ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE]),
			        REMOVEFILTERS('ASSET_PERFORMANCE_DAILY_REPORT'[is_today_minus_2]),
			        DATESBETWEEN(
			            'ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE], 
			            FiscalYearStart, 
			            CurrentDate
			        )
			    )
			
			RETURN 
			    YTD_Avail
			```
		formatString: 0%;-0%;0%
		lineageTag: b79012f0-0a47-48e9-b9c0-ba521de89178

	measure 'Day WESM Rate' =
			
			DIVIDE(
			    SUMX('PEAKING_PLANTS_PROFILES', 'PEAKING_PLANTS_PROFILES'[WESM_REV]),
			    SUM('PEAKING_PLANTS_PROFILES'[WESM_DISPATCH])
			)/ 1000
		formatString: "₱"#,0.00;-"₱"#,0.00;"₱"#,0.00
		lineageTag: c027953c-fb8e-4e5c-9f9c-7d606b868e56

		annotation PBI_FormatHint = {"currencyCulture":"ceb-Latn-PH"}

	measure 'Axis Min (26th of slicer month)' = ```
			
			VAR SelectedStart =
			    MINX ( ALLSELECTED ( ASSET_PERFORMANCE_DAILY_REPORT[CALENDAR_DATE] ), ASSET_PERFORMANCE_DAILY_REPORT[CALENDAR_DATE] )
			RETURN
			DATE ( YEAR ( SelectedStart ), MONTH ( SelectedStart ), 26 )
			
			
			```
		formatString: General Date
		lineageTag: 0f340c21-4c4e-4048-9a6b-18fe810260a1

	measure 'Axis Max (25th next from slicer)' =
			
			VAR SelectedStart =
			    MINX ( ALLSELECTED ( ASSET_PERFORMANCE_DAILY_REPORT[CALENDAR_DATE] ), ASSET_PERFORMANCE_DAILY_REPORT[CALENDAR_DATE] )
			RETURN
			DATE ( YEAR ( SelectedStart ), MONTH ( SelectedStart ) + 1, 25 )
		formatString: General Date
		lineageTag: cac819d4-b7ce-4f93-97c8-d88340432554

