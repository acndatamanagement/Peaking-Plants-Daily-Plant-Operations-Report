	column CUSTOM_MONTH = ```
			
			VAR CurrentDate = 'ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE]
			VAR YearAdj =
			    YEAR ( CurrentDate ) - IF ( MONTH ( CurrentDate ) = 1 && DAY ( CurrentDate ) < 26, 1, 0 )
			VAR MonthAdj =
			    MONTH ( CurrentDate ) - IF ( DAY ( CurrentDate ) < 26, 1, 0 )
			RETURN
			FORMAT ( DATE ( YearAdj, MonthAdj, 26 ), "YYYY-MM" )
			
			```
		lineageTag: 3b9f3942-971c-42ae-b835-51fd268bd5f5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column FISCAL_MONTH =
			
			VAR CurrentDate = 'ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE]
			VAR AdjustedDate =
			    IF(DAY(CurrentDate) >= 26,
			        EDATE(CurrentDate, 1),   -- Shift forward if it's 26 or later
			        CurrentDate              -- Keep same if before 26
			    )
			RETURN
			FORMAT(AdjustedDate, "YYYY-MM")
		lineageTag: 9fbce0cf-9a60-4c3a-9ed6-c5f686fd1346
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column FISCAL_MONTH_START = ```
			
			VAR CurrentDate = 'ASSET_PERFORMANCE_DAILY_REPORT'[CALENDAR_DATE]
			RETURN
			DATE(YEAR(CurrentDate), MONTH(CurrentDate), 26) +
			    IF(DAY(CurrentDate) < 26, -1, 0) * DAY(DATE(YEAR(CurrentDate), MONTH(CurrentDate), 1)) + 25
			
			```
		formatString: General Date
		lineageTag: 3d3cdfbe-005e-41a5-8f2d-9192e8e89d35
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column is_today_minus_2 =
			
